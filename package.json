{
  "name": "cx-agent",
  "version": "0.3.0",
  "type": "module",
  "description": "A blocking bridge MCP server that offloads long tasks to a worker model behind any Anthropic-compatible gateway via the Claude Agent SDK. Blocks the tool call until terminal; emits progress so the call survives the stdio idle window.",
  "license": "Apache-2.0",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "agent",
    "delegation",
    "blocking"
  ],
  "bin": {
    "cx-agent": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "scripts"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build",
    "start": "node dist/index.js",
    "smoke": "node scripts/smoke.mjs",
    "smoke:live": "node scripts/live-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm test && npm run build && npm run smoke"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.250",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vite": "6.4.3",
    "vitest": "^3.2.6"
  }
}
