{
  "name": "cx-agent",
  "version": "0.3.0",
  "type": "module",
  "description": "An MCP delegation server with background jobs, selectable Claude, Codex and Pi workers, and custom model gateways.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/RoyCoding8/Claudex-Agent#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RoyCoding8/Claudex-Agent.git"
  },
  "bugs": {
    "url": "https://github.com/RoyCoding8/Claudex-Agent/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "claude-agent-sdk",
    "agent",
    "subagent",
    "delegation",
    "blocking",
    "gateway",
    "anthropic"
  ],
  "bin": {
    "cx-agent": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "scripts"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build",
    "start": "node dist/index.js",
    "smoke": "node scripts/smoke.mjs",
    "smoke:live": "node scripts/live-smoke.mjs",
    "smoke:engines": "node scripts/engine-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm test && npm run build && npm run smoke && npm run smoke:engines"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.250",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openai/codex-sdk": "0.166.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vite": "6.4.3",
    "vitest": "^3.2.6"
  }
}
