# cx-agent environment reference. Copy to .env (or set in your MCP server config).
# Resolution order per key: CX_AGENT_* env → legacy alias → config file → built-in fallback.
# cx-agent ships with no baked-in host, port, endpoint, model, or credential.

# ─── Gateway (required) ──────────────────────────────────────────────
# Gateway root URL. A trailing /v1 is tolerated but not needed.
CX_AGENT_BASE_URL=https://gateway.example.com
CX_AGENT_API_KEY=sk-your-key
# bearer sends Authorization; api-key uses the Anthropic x-api-key header.
# CX_AGENT_AUTH_MODE=bearer

# ─── Default model ────────────────────────────────────────────────────
# No model ships as a default. Required — either here, or as `pool` under
# `agent_defaults` in a config file (CX_AGENT_CONFIG), or per-call via the
# `model` tool argument.
CX_AGENT_MODEL=

# ─── Discovery ────────────────────────────────────────────────────────
# Optional static catalog (comma-separated). Setting it switches discovery
# to `static` (no /v1/models call).
# CX_AGENT_MODELS=Worker lvl,Opus lvl
# Discovery strategy: models-endpoint | static | none. With CX_AGENT_MODEL set,
# none is inferred and no discovery request is made.
# CX_AGENT_DISCOVERY=models-endpoint
# How long a discovered catalog is cached (ms). Default 60000.
# CX_AGENT_DISCOVERY_TTL_MS=60000

# ─── Worker isolation ─────────────────────────────────────────────────
# By default workers spawn with settingSources: [] — no operator MCP servers,
# hooks, or settings leak into delegated sessions. Set 1 to opt back in
# (needed if workers must use user-level agents/skills).
# CX_AGENT_INHERIT_SETTINGS=0

# ─── Worker budget ────────────────────────────────────────────────────
# Env overrides the config file. Defaults: maxTurns=200, timeoutMs=14400000 (4h),
# maxBudgetUsd=0 (no cap), autoContinue=2. A budget cap ends the job as
# `incomplete` + resumable via cx_agent_reply; autoContinue retries the same
# session in-place up to its value before giving up.
# CX_AGENT_MAX_TURNS=200
# CX_AGENT_TIMEOUT_MS=14400000
# CX_AGENT_MAX_BUDGET_USD=0
# CX_AGENT_AUTO_CONTINUE=2

# ─── Reasoning ───────────────────────────────────────────────────────
# CX_AGENT_THINKING=adaptive
# CX_AGENT_THINKING_DISPLAY=summarized
# CX_AGENT_EFFORT=high
# CX_AGENT_FORWARD_SUBAGENT_TEXT=0

# ─── Provider selection ──────────────────────────────────────────────
# Only one provider ships: the env-driven gateway. "auto" (default) and
# "gateway" are synonyms; "openai-compatible" is accepted as a legacy synonym.
# CX_AGENT_PROVIDER=auto

# ─── Data + runtime ──────────────────────────────────────────────────
# Job transcript + .meta.json root. Defaults: %LOCALAPPDATA%\cx-agent (win32),
# $XDG_DATA_HOME/cx-agent or ~/.local/share/cx-agent (POSIX).
# CX_AGENT_DATA_DIR=
# Worker shell path (win32 only). Default: C:\Program Files\Git\bin\bash.exe
# CX_AGENT_SHELL_PATH=C:\Program Files\Git\bin\bash.exe
# JSON config file path. Top-level or under agent_defaults.
# CX_AGENT_CONFIG=/path/to/settings.json

# ─── Recursion guard ─────────────────────────────────────────────────
# Max delegation nesting. Default 2. Set 0 to disable.
# CX_AGENT_MAX_DEPTH=2
# Current depth (stamped by the runtime; do not set manually).
# CX_AGENT_DEPTH=0

# ─── Legacy aliases (still accepted; prefer the CX_AGENT_* names above) ─
# CX_AGENT_SETTINGS             → CX_AGENT_CONFIG
# CLAUDE_CODE_GIT_BASH_PATH     → CX_AGENT_SHELL_PATH
